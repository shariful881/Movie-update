---
// আসল পোস্টারের বদলে হাতে আঁকা সিনেমা-পোস্টারের ধাঁচে রঙিন টাইল
import { tileColors, typeSingular, type TitleType } from '../lib/format';
interface Props { id: string; title: string; type: TitleType; dubbed?: boolean; size?: 'sm' | 'lg' }
const { id, title, type, dubbed = false, size = 'sm' } = Astro.props;
const c = tileColors(id);
const long = [...title].length > 14;
---
<div class:list={['poster', `poster-${size}`, { long }]} style={`--tb:${c.bg};--tf:${c.fg};--ti:${c.ink}`} aria-hidden="true">
  <span class="p-type">{typeSingular[type]}{dubbed ? ', বাংলা ডাবিং' : ''}</span>
  <span class="p-title">{title}</span>
</div>
<style>
  .poster {
    position: relative;
    aspect-ratio: 2 / 3;
    max-width: 100%;
    border-radius: 8px;
    background:
      radial-gradient(circle at 100% 0, var(--ti) 0 18%, transparent 18.5%),
      radial-gradient(circle at 100% 0, transparent 0 24%, color-mix(in srgb, var(--ti) 55%, transparent) 24.5% 26%, transparent 26.5%),
      var(--tb);
    color: var(--tf);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 14px 12px;
    overflow: hidden;
    box-shadow: inset 0 0 0 4px var(--tb), inset 0 0 0 6px color-mix(in srgb, var(--tf) 70%, transparent);
  }
  .p-type { font-size: 12px; font-weight: 600; opacity: 0.9; line-height: 1.3; }
  .p-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 80%;
    font-size: 26px;
    line-height: 1.08;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .long .p-title { font-size: 20px; }
  .poster-lg { border-radius: 12px; padding: 22px 18px; }
  .poster-lg .p-title { font-size: clamp(34px, 5vw, 46px); }
  .poster-lg.long .p-title { font-size: clamp(26px, 3.6vw, 34px); }
  .poster-lg .p-type { font-size: 14px; }
</style>
