---
import type { CollectionEntry } from 'astro:content';
import { bn, titleUrl, typeSingular } from '../lib/format';
interface Props { entry: CollectionEntry<'titles'>; platformNames: Record<string, string>; note?: string }
const { entry, platformNames, note } = Astro.props;
const d = entry.data;
const where = d.availability.map((a) => platformNames[a.platform.id] ?? a.platform.id).join(', ');
const meta = [typeSingular[d.type], d.year && bn(d.year), d.dubbed && 'বাংলা ডাবিং', d.episodes && d.type !== 'movie' && `${bn(d.episodes)} পর্ব`].filter(Boolean).join(' · ');
---
<a class="title-card" href={titleUrl(entry)}>
  <span class="t-type">{meta}</span>
  <span class="t-name">{d.title}</span>
  {note && <span class="t-note">{note}</span>}
  <span class="t-where">{where ? `দেখুন: ${where}` : 'প্রাপ্যতা যাচাই চলছে'}</span>
</a>
<style>
  .title-card {
    display: flex; flex-direction: column; gap: 4px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 16px 18px; text-decoration: none; color: var(--text); min-height: 44px;
  }
  .title-card:hover { border-color: var(--accent); color: var(--text); }
  .t-type { font-size: 13px; color: var(--muted); }
  .t-name { font-size: 21px; font-weight: 700; line-height: 1.3; }
  .t-note { font-size: 14px; color: var(--soft); }
  .t-where { font-size: 15px; color: var(--accent); }
</style>
