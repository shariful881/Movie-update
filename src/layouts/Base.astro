---
import '../styles/global.css';
import { bn, link } from '../lib/format';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  wide?: boolean;
}
const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('সিনেখোঁজ') ? title : `${title} | সিনেখোঁজ`;
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const year = new Date().getFullYear();
const here = Astro.url.pathname;
const nav = [
  { href: '/movie/', label: 'সিনেমা' },
  { href: '/series/', label: 'সিরিজ' },
  { href: '/natok/', label: 'নাটক' },
  { href: '/list/bangla-dubbing/', label: 'বাংলা ডাবিং' },
  { href: '/list/', label: 'তালিকা' },
  { href: '/person/', label: 'তারকা' },
  { href: '/platform/', label: 'প্ল্যাটফর্ম' },
];
const searchIndex = link('/search.json');
---
<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="সিনেখোঁজ" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="bn_BD" />
    <meta name="theme-color" content="#c2185b" />
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={link('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anek+Bangla:wdth,wght@75..100,500..800&family=Hind+Siliguri:wght@400;500;600;700&display=swap" />
    {adClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous"></script>
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">মূল লেখায় যান</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a href={link('/')} class="logo" aria-label="সিনেখোঁজ, হোম">
          <span class="logo-mark" aria-hidden="true"></span>
          <span>সিনেখোঁজ</span>
        </a>
        <form class="search" role="search" action={link('/')} data-index={searchIndex}>
          <label for="site-search" class="sr-only">সিনেমা, নাটক, সিরিজ বা তারকার নাম খুঁজুন</label>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          <input id="site-search" type="search" autocomplete="off" placeholder="কী দেখতে চান? নাম লিখুন" aria-controls="search-results" aria-expanded="false" />
          <ul id="search-results" class="results" role="listbox" hidden></ul>
        </form>
      </div>
      <nav aria-label="প্রধান মেনু" class="wrap nav">
        {nav.map((n) => <a href={link(n.href)} aria-current={here.startsWith(link(n.href)) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main id="main" class="wrap main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-about">
          <a href={link('/')} class="logo logo-sm"><span class="logo-mark" aria-hidden="true"></span><span>সিনেখোঁজ</span></a>
          <p>বাংলাদেশ থেকে কোন সিনেমা, নাটক আর সিরিজ কোথায় বৈধভাবে দেখা যায়, তার বাংলা গাইড। আমরা কোনো ভিডিও হোস্ট করি না, পাইরেটেড লিংকও দিই না।</p>
        </div>
        <nav aria-label="বিভাগ" class="footer-links">
          <a href={link('/movie/')}>সিনেমা</a>
          <a href={link('/series/')}>সিরিজ ও ধারাবাহিক</a>
          <a href={link('/natok/')}>নাটক</a>
          <a href={link('/list/')}>তালিকা</a>
          <a href={link('/platform/')}>ওটিটি প্ল্যাটফর্ম</a>
        </nav>
        <nav aria-label="সাইটের তথ্য" class="footer-links">
          <a href={link('/amader-kotha/')}>আমাদের কথা</a>
          <a href={link('/kivabe-jachai-kori/')}>আমরা কীভাবে যাচাই করি</a>
          <a href={link('/jogajog/')}>যোগাযোগ</a>
          <a href={link('/privacy-policy/')}>প্রাইভেসি পলিসি</a>
        </nav>
      </div>
      <div class="wrap footer-base">© {bn(year)} সিনেখোঁজ</div>
    </footer>
    <script is:inline>
      (() => {
        const form = document.querySelector('.search');
        if (!form) return;
        const input = form.querySelector('input');
        const list = form.querySelector('.results');
        let data = null;
        let active = -1;
        const norm = (s) => s.toLowerCase().normalize('NFKC').replace(/\s+/g, ' ').trim();
        const load = async () => {
          if (data) return data;
          try {
            const r = await fetch(form.dataset.index);
            data = (await r.json()).map((x) => ({ ...x, k: norm(`${x.t} ${x.e || ''}`) }));
          } catch { data = []; }
          return data;
        };
        const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; };
        const render = (items, q) => {
          list.innerHTML = '';
          if (!q) return close();
          if (!items.length) {
            const li = document.createElement('li');
            li.className = 'empty';
            li.textContent = 'কিছু পাওয়া যায়নি। অন্য বানানে বা ইংরেজিতে লিখে দেখুন।';
            list.append(li);
          }
          items.forEach((x, i) => {
            const li = document.createElement('li');
            li.setAttribute('role', 'option');
            li.id = `sr-${i}`;
            const a = document.createElement('a');
            a.href = x.u;
            const t = document.createElement('span');
            t.className = 'r-t';
            t.textContent = x.t;
            const m = document.createElement('span');
            m.className = 'r-m';
            m.textContent = [x.k2, x.y].filter(Boolean).join(', ');
            a.append(t, m);
            li.append(a);
            list.append(li);
          });
          list.hidden = false;
          input.setAttribute('aria-expanded', 'true');
        };
        input.addEventListener('focus', load, { once: true });
        input.addEventListener('input', async () => {
          const q = norm(input.value);
          const all = await load();
          const hits = q ? all.filter((x) => x.k.includes(q)).sort((a, b) => a.k.indexOf(q) - b.k.indexOf(q)).slice(0, 8) : [];
          render(hits, q);
        });
        input.addEventListener('keydown', (e) => {
          const opts = [...list.querySelectorAll('[role=option]')];
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            if (!opts.length) return;
            e.preventDefault();
            active = (active + (e.key === 'ArrowDown' ? 1 : -1) + opts.length) % opts.length;
            opts.forEach((o, i) => o.classList.toggle('on', i === active));
            input.setAttribute('aria-activedescendant', opts[active].id);
          } else if (e.key === 'Escape') close();
        });
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const opts = [...list.querySelectorAll('[role=option] a')];
          const pick = opts[Math.max(active, 0)];
          if (pick) location.href = pick.href;
        });
        document.addEventListener('click', (e) => { if (!form.contains(e.target)) close(); });
      })();
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface); padding: 8px 12px; z-index: 20; }
  .skip:focus { left: 12px; }
  :global(.sr-only) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .site-header { background: var(--surface); border-bottom: 1px solid var(--line); }
  .header-row { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; padding-top: 14px; padding-bottom: 10px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 800; font-size: 28px; font-stretch: 85%; color: var(--text); text-decoration: none; line-height: 1; }
  .logo:hover { color: var(--text); }
  .logo-mark {
    width: 30px; height: 30px; border-radius: 8px; flex: none;
    background:
      radial-gradient(circle at 70% 30%, var(--marigold) 0 22%, transparent 23%),
      linear-gradient(135deg, var(--magenta) 0 50%, var(--teal) 50% 100%);
  }
  .logo-sm { font-size: 22px; }
  .logo-sm .logo-mark { width: 24px; height: 24px; border-radius: 6px; }

  .search { position: relative; flex: 1 1 320px; max-width: 560px; margin-left: auto; }
  .search svg { position: absolute; left: 14px; top: 50%; width: 18px; height: 18px; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  .search input {
    width: 100%; min-height: 46px; padding: 0 16px 0 42px; font: inherit; font-size: 16px;
    border-radius: 999px; border: 1.5px solid var(--line-strong); background: var(--surface-2); color: var(--text);
  }
  .search input::placeholder { color: var(--faint); }
  .search input:focus { outline: none; border-color: var(--accent); background: var(--surface); }
  .results {
    position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 30; margin: 0; padding: 6px; list-style: none;
    background: var(--surface); border: 1px solid var(--line-strong); border-radius: 14px;
    box-shadow: 0 12px 32px rgb(20 20 40 / 0.16); max-height: 70vh; overflow-y: auto;
  }
  .results :global(a) { display: flex; flex-direction: column; padding: 8px 12px; border-radius: 10px; text-decoration: none; color: var(--text); }
  .results :global(a:hover), .results :global(.on a) { background: var(--surface-2); }
  .results :global(.r-t) { font-weight: 700; }
  .results :global(.r-m) { font-size: 13px; color: var(--muted); }
  .results :global(.empty) { padding: 10px 12px; color: var(--muted); font-size: 15px; }

  .nav { display: flex; gap: 4px 22px; overflow-x: auto; scrollbar-width: none; font-size: 16px; font-weight: 600; }
  .nav::-webkit-scrollbar { display: none; }
  .nav a { color: var(--soft); text-decoration: none; padding: 8px 0 10px; white-space: nowrap; border-bottom: 3px solid transparent; }
  .nav a:hover { color: var(--text); border-bottom-color: var(--line-strong); }
  .nav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--accent); }

  .main { padding-top: 28px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 40px; }

  .site-footer { border-top: 1px solid var(--line); background: var(--surface-2); color: var(--muted); font-size: 15px; }
  .footer-grid { display: grid; gap: 24px 40px; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); padding-top: 36px; padding-bottom: 24px; }
  .footer-about { display: flex; flex-direction: column; gap: 12px; max-width: 46ch; }
  .footer-links { display: flex; flex-direction: column; gap: 6px; }
  .footer-links a { color: var(--soft); text-decoration: none; }
  .footer-links a:hover { color: var(--link); text-decoration: underline; }
  .footer-base { padding-top: 14px; padding-bottom: 28px; border-top: 1px solid var(--line); font-size: 14px; }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .footer-about { grid-column: 1 / -1; }
  }
</style>
