---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TitleCard from '../../components/TitleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { accessLabel, bnDate } from '../../lib/format';

export async function getStaticPaths() {
  const platforms = await getCollection('platforms');
  return platforms.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const platforms = await getCollection('platforms');
const platformNames = Object.fromEntries(platforms.map((p) => [p.id, p.data.name]));
const titles = await getCollection('titles', ({ data }) => !data.draft && data.availability.some((a) => a.platform.id === entry.id));
---
<Base title={`${d.name} (${d.nameEn}): কী দেখা যায়, দাম ও সাবস্ক্রিপশন`} description={`${d.name} ওটিটি প্ল্যাটফর্মে কী পাওয়া যায়, সাবস্ক্রিপশন লাগে কিনা, আর এখানে থাকা সিনেমা, নাটক ও সিরিজের তালিকা।`}>
  <nav aria-label="অবস্থান" class="small muted"><a href="/" style="color: var(--muted)">হোম</a> › <a href="/platform/" style="color: var(--muted)">ওটিটি প্ল্যাটফর্ম</a> › {d.name}</nav>
  <div class="stack" style="gap: 8px">
    <h1>{d.name} ({d.nameEn})</h1>
    <p class="muted">{d.tagline}</p>
    <p class="small muted">{accessLabel[d.access]}{d.lastVerified ? ` · সর্বশেষ যাচাই: ${bnDate(d.lastVerified)}` : ''}</p>
  </div>

  {d.highlights.length > 0 && (
    <ul class="card highlights">{d.highlights.map((h) => <li>{h}</li>)}</ul>
  )}

  <div>
    <a class="btn" href={d.affiliateUrl ?? d.url} rel={d.affiliateUrl ? 'sponsored noopener' : 'noopener'} target="_blank">{d.name}-এর ওয়েবসাইটে যান</a>
  </div>

  <section class="prose"><Content /></section>

  <AdSlot label="বিজ্ঞাপন" />

  <section class="section">
    <h2>{d.name}তে যা দেখা যায়</h2>
    {titles.length ? (
      <div class="grid">{titles.map((t) => <TitleCard entry={t} platformNames={platformNames} />)}</div>
    ) : (
      <p class="card muted">শিগগিরই তালিকা যোগ হবে।</p>
    )}
  </section>

  {d.sources.length > 0 && (
    <p class="small muted">তথ্যসূত্র: {d.sources.map((s, i) => <>{i > 0 && ', '}<a href={s.url} rel="noopener" target="_blank">{s.name}</a></>)}</p>
  )}
</Base>
<style>
  .highlights { margin: 0; padding-left: 38px; color: var(--soft); }
</style>
