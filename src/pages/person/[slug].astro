---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TitleCard from '../../components/TitleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { bn, jobLabel, link, personUrl } from '../../lib/format';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const titles = (await getCollection('titles', ({ data }) => !data.draft)).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const platforms = await getCollection('platforms');
const platformNames = Object.fromEntries(platforms.map((p) => [p.id, p.data.name]));

const asActor = titles.filter((t) => t.data.cast.some((c) => c.id === entry.id));
const byJob = (job: 'director' | 'producer' | 'company') => titles.filter((t) => t.data.crew.some((c) => c.id === entry.id && c.job === job));
const groups = [
  { label: 'অভিনয় করেছেন', items: asActor },
  { label: 'পরিচালনা করেছেন', items: byJob('director') },
  { label: 'প্রযোজনা করেছেন', items: byJob('producer') },
  { label: 'প্রযোজনা প্রতিষ্ঠান হিসেবে', items: byJob('company') },
].filter((g) => g.items.length);
const all = [...new Map(groups.flatMap((g) => g.items).map((t) => [t.id, t])).values()];
const roles = [
  asActor.length && jobLabel.actor,
  byJob('director').length && jobLabel.director,
  byJob('producer').length && jobLabel.producer,
  byJob('company').length && jobLabel.company,
].filter(Boolean).join(', ');
const indexable = all.some((t) => t.data.lastVerified);
const isCompany = d.kind === 'company';
const pageTitle = isCompany ? `${d.name}-এর সব সিনেমা ও সিরিজ কোথায় দেখবেন` : `${d.name}-এর সব সিনেমা ও নাটক কোথায় দেখবেন`;
const description = `${d.name} (${roles})। ${bn(all.length)}টি কাজের তালিকা আর বাংলাদেশ থেকে কোনটা কোথায় দেখা যায়।`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isCompany ? 'Organization' : 'Person',
  name: d.name,
  alternateName: d.nameEn,
  url: new URL(personUrl(entry.id), Astro.site).toString(),
  ...(d.wikidata && { sameAs: [`https://www.wikidata.org/wiki/${d.wikidata}`] }),
};
---
<Base title={pageTitle} description={description} jsonLd={jsonLd} noindex={!indexable}>
  <nav aria-label="অবস্থান" class="small muted"><a href={link('/')} style="color: var(--muted)">হোম</a> › <a href={link('/person/')} style="color: var(--muted)">তারকা ও নির্মাতা</a> › {d.name}</nav>
  <div class="stack" style="gap: 6px">
    <span class="small muted">{roles}{d.nameEn !== d.name ? ` · ${d.nameEn}` : ''}</span>
    <h1>{pageTitle}</h1>
    <p class="muted">সিনেখোঁজে {d.name}-এর {bn(all.length)}টি কাজ আছে।</p>
  </div>
  <AdSlot label="বিজ্ঞাপন" />
  {groups.map((g) => (
    <section class="section">
      <h2>{g.label} ({bn(g.items.length)})</h2>
      <div class="grid">{g.items.map((t) => <TitleCard entry={t} platformNames={platformNames} />)}</div>
    </section>
  ))}
  {d.wikidata && (
    <p class="small muted">তথ্যসূত্র: <a href={`https://www.wikidata.org/wiki/${d.wikidata}`} rel="noopener" target="_blank">উইকিডাটা ({d.wikidata})</a></p>
  )}
</Base>
