---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TitleCard from '../../components/TitleCard.astro';
import { bn, link, typeLabel, typePath, type TitleType } from '../../lib/format';

export function getStaticPaths() {
  return (Object.keys(typePath) as TitleType[]).map((t) => ({ params: { type: typePath[t] }, props: { kind: t } }));
}

const { kind } = Astro.props as { kind: TitleType };
const titles = (await getCollection('titles', ({ data }) => !data.draft && data.type === kind)).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.title.localeCompare(b.data.title, 'bn'),
);
const platforms = (await getCollection('platforms')).sort((a, b) => a.data.order - b.data.order);
const platformNames = Object.fromEntries(platforms.map((p) => [p.id, p.data.name]));
const label = typeLabel[kind];
const groups = platforms
  .map((p) => ({ p, items: titles.filter((t) => t.data.availability[0]?.platform.id === p.id) }))
  .filter((g) => g.items.length);
const noPlatform = titles.filter((t) => !t.data.availability.length);
const indexable = titles.some((t) => t.data.lastVerified);
---
<Base title={`${label} কোথায় দেখবেন`} description={`বাংলাদেশ থেকে কোন ${label} কোন ওটিটিতে দেখা যায়: ${bn(titles.length)}টির তালিকা।`} noindex={!indexable}>
  <nav aria-label="অবস্থান" class="crumbs"><a href={link('/')}>হোম</a> <span aria-hidden="true">/</span> {label}</nav>
  <div class="stack" style="gap: 6px">
    <h1>{label} কোথায় দেখবেন</h1>
    <p class="muted">মোট {bn(titles.length)}টি। প্ল্যাটফর্ম অনুযায়ী সাজানো।</p>
  </div>
  {groups.length > 1 && (
    <nav aria-label="প্ল্যাটফর্ম" class="jump">
      {groups.map((g) => <a class="chip" href={`#${g.p.id}`}>{g.p.data.name} ({bn(g.items.length)})</a>)}
    </nav>
  )}
  {groups.map((g) => (
    <section class="section" id={g.p.id}>
      <h2>{g.p.data.name}</h2>
      <div class="tiles">{g.items.map((t) => <TitleCard entry={t} platformNames={platformNames} />)}</div>
    </section>
  ))}
  {noPlatform.length > 0 && (
    <section class="section">
      <h2>প্ল্যাটফর্ম যাচাই চলছে</h2>
      <div class="tiles">{noPlatform.map((t) => <TitleCard entry={t} platformNames={platformNames} />)}</div>
    </section>
  )}
  {!titles.length && <p class="card muted">এই বিভাগে শিগগিরই {label} যোগ হবে।</p>}
</Base>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
