---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import TitleCard from '../../components/TitleCard.astro';
import { accessLabel, bn, bnDate, bnRuntime, isVerified, jobLabel, link, personUrl, titleUrl, typeLabel, typePath, typeSingular } from '../../lib/format';

export async function getStaticPaths() {
  const titles = await getCollection('titles', ({ data }) => !data.draft);
  return titles.map((entry) => ({ params: { type: typePath[entry.data.type], slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const verified = isVerified(entry);

const allPlatforms = (await getCollection('platforms')).sort((a, b) => a.data.order - b.data.order);
const platformNames = Object.fromEntries(allPlatforms.map((p) => [p.id, p.data.name]));
const available = await Promise.all(d.availability.map(async (a) => ({ ...a, p: await getEntry(a.platform) })));
const availableIds = new Set(d.availability.map((a) => a.platform.id));
const otherPlatforms = allPlatforms.filter((p) => !availableIds.has(p.id));
const where = available.map((a) => a.p?.data.name).filter(Boolean).join(', ');

const peopleIds = new Set((await getCollection('people')).map((p) => p.id));
const personLink = (id?: string) => (id && peopleIds.has(id) ? personUrl(id) : null);
const crewBy = (job: 'director' | 'producer' | 'company') => d.crew.filter((c) => c.job === job);
const directorText = d.director || crewBy('director').map((c) => c.name).join(', ');
const productionText = d.production || crewBy('company').map((c) => c.name).join(', ');

const yearText = d.year ? ` (${bn(d.year)})` : '';
const pageTitle = `${d.title}${yearText} কোথায় দেখবেন? ${where || 'ওটিটি তথ্য'}`;
const summary =
  d.summary ||
  (where
    ? `${d.title}${yearText} বাংলাদেশ থেকে দেখা যায় ${where}-এ।${d.episodes ? ` মোট ${bn(d.episodes)}টি পর্ব।` : ''}`
    : `${d.title}${yearText} কোথায় দেখা যায় তা এখনো যাচাই করা হয়নি।`);
const url = new URL(titleUrl(entry), Astro.site).toString();
const typeHref = link(`/${typePath[d.type]}/`);

const facts = [
  d.releaseDate && { label: d.type === 'movie' ? 'মুক্তি' : 'প্রথম প্রচার', value: `${bnDate(d.releaseDate)}${d.releaseNote ? ` (${d.releaseNote})` : ''}` },
  !d.releaseDate && d.year && { label: 'মুক্তির বছর', value: bn(d.year) },
  d.ottReleaseDate && { label: 'ওটিটিতে মুক্তি', value: bnDate(d.ottReleaseDate) },
  d.runtimeMinutes && { label: 'দৈর্ঘ্য', value: bnRuntime(d.runtimeMinutes) },
  d.seasons && d.seasons > 1 && { label: 'সিজন', value: `${bn(d.seasons)}টি` },
  d.episodes && { label: 'মোট পর্ব', value: `${bn(d.episodes)}টি` },
  d.genres.length && { label: 'ধরন', value: d.genres.join(', ') },
  directorText && { label: 'পরিচালক', value: directorText },
  productionText && { label: 'প্রযোজনা', value: productionText },
  d.origin && { label: 'মূল দেশ', value: d.origin },
  { label: 'ভাষা', value: d.dubbed ? `${d.language} (ডাবিং)` : d.language },
  d.ageRating && { label: 'বয়স উপযোগিতা', value: d.ageRating, warn: true },
].filter(Boolean) as { label: string; value: string; warn?: boolean }[];

const familyHead = { yes: 'হ্যাঁ।', caution: 'সাবধানে।', no: 'না।' } as const;

// একই অভিনেতার আরও কাজ, বা একই প্ল্যাটফর্ম ও ধরনের আরও টাইটেল
const others = (await getCollection('titles', ({ data }) => !data.draft)).filter((t) => t.id !== entry.id);
const castIds = new Set(d.cast.map((c) => c.id).filter(Boolean));
const related = [
  ...others.filter((t) => t.data.cast.some((c) => c.id && castIds.has(c.id))),
  ...others.filter((t) => t.data.type === d.type && t.data.availability.some((a) => availableIds.has(a.platform.id))),
]
  .filter((t, i, arr) => arr.findIndex((x) => x.id === t.id) === i)
  .slice(0, 6);

const work: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': d.type === 'movie' ? 'Movie' : 'TVSeries',
  name: d.title,
  alternateName: d.titleEn,
  url,
  inLanguage: 'bn',
  genre: d.genres,
  ...(d.releaseDate && { datePublished: d.releaseDate.toISOString().slice(0, 10) }),
  ...(d.runtimeMinutes && { duration: `PT${d.runtimeMinutes}M` }),
  ...(d.episodes && d.type !== 'movie' && { numberOfEpisodes: d.episodes }),
  ...(directorText && { director: directorText.split(', ').map((name) => ({ '@type': 'Person', name })) }),
  ...(d.cast.length && { actor: d.cast.slice(0, 10).map((c) => ({ '@type': 'Person', name: c.name })) }),
  ...(d.ageRating && { contentRating: d.ageRating }),
  ...(d.wikidata && { sameAs: [`https://www.wikidata.org/wiki/${d.wikidata}`] }),
};
const jsonLd = [
  work,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'হোম', item: new URL(link('/'), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: typeLabel[d.type], item: new URL(typeHref, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
  ...(d.faqs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
];
---
<Base title={pageTitle} description={summary} jsonLd={jsonLd} noindex={!verified}>
  <nav aria-label="অবস্থান" class="crumbs small muted">
    <a href={link('/')}>হোম</a> › <a href={typeHref}>{typeLabel[d.type]}</a> › <span>{d.title}</span>
  </nav>

  <div class="stack" style="gap: 8px">
    <span class="small muted">{typeSingular[d.type]}{d.dubbed ? ' · বাংলা ডাবিং' : ''}{d.titleEn && d.titleEn !== d.title ? ` · ${d.titleEn}` : ''}</span>
    <h1>{d.title}{yearText} কোথায় দেখবেন?</h1>
    {verified ? (
      <p class="small muted">সর্বশেষ যাচাই: {bnDate(d.lastVerified)}</p>
    ) : (
      <p class="small verify-pending">এই পাতার তথ্য এখনো অ্যাপে যাচাই করা হয়নি। প্ল্যাটফর্মের সাইটম্যাপ ও উইকিডাটার ভিত্তিতে তৈরি।</p>
    )}
  </div>

  <section class="card answer" aria-label="সংক্ষিপ্ত উত্তর">
    <span class="answer-label">সংক্ষেপে উত্তর</span>
    <p>{summary}</p>
  </section>

  <div class="grid facts">
    {facts.map((f) => (
      <div class="card fact">
        <span class="small muted">{f.label}</span>
        <span class:list={['fact-value', { warn: f.warn }]}>{f.value}</span>
      </div>
    ))}
  </div>

  <AdSlot label="বিজ্ঞাপন" />

  <section class="section">
    <h2>কোথায় দেখবেন</h2>
    {available.length ? (
      <div class="grid platforms">
        {available.map((a) => a.p && (
          <div class="card platform">
            <div class="platform-head">
              <span class="platform-name">{a.p.data.name}</span>
              <span class:list={['pill', { 'pill-warn': !verified }]}>{verified ? 'আছে' : 'যাচাই বাকি'}</span>
            </div>
            <p class="small muted">{accessLabel[a.p.data.access]}{a.note ? ` · ${a.note}` : ''}</p>
            <a class="btn" href={a.p.data.affiliateUrl ?? a.url ?? a.p.data.url} rel={a.p.data.affiliateUrl ? 'sponsored noopener' : 'noopener'} target="_blank">
              {a.p.data.name} খুলুন
            </a>
            <a class="small" href={link(`/platform/${a.p.id}/`)}>{a.p.data.name} সম্পর্কে বিস্তারিত</a>
          </div>
        ))}
      </div>
    ) : (
      <p class="card">এখনো কোনো বৈধ প্ল্যাটফর্মে পাওয়া যায়নি। পাওয়া গেলে এখানে আপডেট করা হবে।</p>
    )}
    {d.checkedPlatforms.length > 0 && (
      <p class="small muted">আমরা খুঁজেছি: {d.checkedPlatforms.join(', ')}। যেগুলোর নাম উপরে নেই, সেখানে পাওয়া যায়নি।</p>
    )}
    <p class="small muted">সিনেখোঁজ কোনো সিনেমা হোস্ট করে না এবং পাইরেটেড লিংক দেয় না।</p>
  </section>

  {d.family && (
    <section class="section">
      <h2>পরিবার নিয়ে দেখা যাবে?</h2>
      <div class:list={['card', 'family', `family-${d.family.verdict}`]}>
        <strong>{familyHead[d.family.verdict]}</strong> {d.family.text}
      </div>
      {d.family.items.length > 0 && (
        <div class="grid">
          {d.family.items.map((i) => (
            <div class="card">
              <div style="font-weight: 600">{i.label}</div>
              <div class:list={['lvl', `lvl-${i.level}`]}>{i.text}</div>
            </div>
          ))}
        </div>
      )}
    </section>
  )}

  {hasBody && (
    <section class="section">
      <h2>কাহিনি সংক্ষেপ (স্পয়লার নেই)</h2>
      <div class="prose"><Content /></div>
    </section>
  )}

  <AdSlot label="বিজ্ঞাপন" />

  {d.cast.length > 0 && (
    <section class="section">
      <h2>অভিনয়শিল্পী</h2>
      <div class="grid cast">
        {d.cast.map((c) => {
          const href = personLink(c.id);
          return href ? (
            <a class="card person" href={href}>
              <span style="font-weight: 600">{c.name}</span>
              {c.role && <span class="small muted">{c.role}</span>}
              <span class="small">সব কাজ দেখুন</span>
            </a>
          ) : (
            <div class="card">
              <div style="font-weight: 600">{c.name}</div>
              {c.role && <div class="small muted">{c.role}</div>}
            </div>
          );
        })}
      </div>
    </section>
  )}

  {d.crew.length > 0 && (
    <section class="section">
      <h2>নির্মাণে</h2>
      <div class="grid cast">
        {d.crew.map((c) => {
          const href = personLink(c.id);
          return (
            <div class="card">
              <div class="small muted">{jobLabel[c.job]}</div>
              {href ? <a href={href} style="font-weight: 600">{c.name}</a> : <div style="font-weight: 600">{c.name}</div>}
            </div>
          );
        })}
      </div>
    </section>
  )}

  {d.facts.length > 0 && (
    <section class="grid wide">
      {d.facts.map((f) => (
        <div class="card stack" style="gap: 6px">
          <h2 style="font-size: 21px">{f.heading}</h2>
          <p class="prose">{f.text}</p>
        </div>
      ))}
    </section>
  )}

  {d.faqs.length > 0 && (
    <section class="section">
      <h2>সাধারণ প্রশ্ন</h2>
      {d.faqs.map((f) => (
        <div class="card">
          <h3 style="font-size: 17px">{f.q}</h3>
          <p class="prose">{f.a}</p>
        </div>
      ))}
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <h2>আরও দেখুন</h2>
      <div class="grid">{related.map((t) => <TitleCard entry={t} platformNames={platformNames} />)}</div>
    </section>
  )}

  {otherPlatforms.length > 0 && (
    <section class="section">
      <h2>বাংলাদেশের অন্যান্য ওটিটি</h2>
      <p class="small muted">এটা সাধারণ তালিকা। এই প্ল্যাটফর্মগুলোতে {d.title} আছে, এমন দাবি নয়।</p>
      <div style="display: flex; flex-wrap: wrap; gap: 10px">
        {otherPlatforms.map((p) => <a class="chip" href={link(`/platform/${p.id}/`)}>{p.data.name}</a>)}
      </div>
    </section>
  )}

  <AdSlot label="বিজ্ঞাপন" />

  {d.sources.length > 0 && (
    <p class="small muted">
      তথ্যসূত্র: {d.sources.map((s, i) => <>{i > 0 && ', '}<a href={s.url} rel="noopener" target="_blank">{s.name}</a></>)}।
      ওটিটিতে থাকা না থাকা সময়ের সাথে বদলায়। ভুল দেখলে <a href={link('/jogajog/')}>আমাদের জানান</a>।
    </p>
  )}
</Base>

<style>
  .crumbs a { color: var(--muted); }
  .verify-pending { color: var(--warn); }
  .answer { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px; }
  .answer-label { font-size: 13px; font-weight: 600; color: var(--accent); }
  .answer p { font-size: 19px; }
  .facts { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .fact { display: flex; flex-direction: column; }
  .fact-value { font-size: 18px; font-weight: 600; }
  .fact-value.warn { color: var(--bad); }
  .platforms { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .platform { display: flex; flex-direction: column; gap: 10px; padding: 20px; }
  .platform-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .platform-name { font-size: 22px; font-weight: 700; }
  .family { font-size: 18px; }
  .family-no { background: var(--bad-bg); border-color: var(--bad-line); }
  .family-no strong { color: var(--bad); }
  .family-caution strong { color: var(--warn); }
  .family-yes strong { color: var(--ok); }
  .lvl-high { color: var(--bad); }
  .lvl-mid { color: var(--warn); }
  .lvl-low { color: #c9cdd4; }
  .cast { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .person { display: flex; flex-direction: column; gap: 2px; text-decoration: none; color: var(--text); }
  .person:hover { border-color: var(--accent); color: var(--text); }
  .wide { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
</style>
